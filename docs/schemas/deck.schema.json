{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-tarot.local/schemas/deck.schema.json",
  "title": "Deck",
  "description": "一副牌组。对应 src/shared/types.ts 的 Deck。牌组的全部领域数据必须来自此结构，代码不得硬编码任何一张牌。",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "cards"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1, "description": "结构版本，当前恒为 1。" },
    "id": { "$ref": "#/$defs/id", "description": "牌组标识，同一目录内唯一。" },
    "name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "description": "牌面列表。顺序即牌组内顺序，洗牌前不改。",
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "localized": {
      "title": "Localized",
      "description": "中日双语文本。两种语言都必须非空。",
      "type": "object",
      "required": ["zh", "ja"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "ja": { "type": "string", "minLength": 1 }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "card": {
      "title": "Card",
      "type": "object",
      "required": ["id", "word", "upright", "reversed", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "word": { "$ref": "#/$defs/localized", "description": "牌面上的词。原版卢恩以日文原词为准，中文为对照。" },
        "symbol": {
          "type": "string",
          "description": "装饰符号（卢恩符文、罗马编号或几何字符），无实质含义。可选。"
        },
        "upright": { "$ref": "#/$defs/localized", "description": "正位释义。为本应用创作，不冒充任何原著。" },
        "reversed": { "$ref": "#/$defs/localized", "description": "逆位释义，含义反转。" },
        "questions": {
          "type": "object",
          "required": ["upright", "reversed"],
          "additionalProperties": false,
          "description": "正位与逆位各一条引导问句。",
          "properties": {
            "upright": { "$ref": "#/$defs/localized" },
            "reversed": { "$ref": "#/$defs/localized" }
          }
        }
      }
    }
  }
}
