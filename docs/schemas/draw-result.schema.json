{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-tarot.local/schemas/draw-result.schema.json",
  "title": "DrawResult",
  "description": "一次抽卡的结果。对应 src/shared/types.ts 的 DrawResult 与 DrawnCard。/api/draw（GET 与 POST）与 /api/history 中的 result 字段均为此结构。结果不含实时时间：时间只存在于 HistoryEntry.drawnAt，因此同一 seed 的 HTTP 响应可以逐字一致。",
  "type": "object",
  "required": [
    "schemaVersion",
    "engineVersion",
    "deckId",
    "deckName",
    "layoutId",
    "layoutName",
    "interpretationId",
    "seed",
    "reversedProbability",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "engineVersion": { "const": "1", "description": "抽卡引擎版本。固定 seed + 领域数据 + 引擎版本 = 完全一致的结果。" },
    "deckId": { "type": "string", "minLength": 1 },
    "deckName": { "$ref": "#/$defs/localized" },
    "layoutId": { "type": "string", "minLength": 1 },
    "layoutName": { "$ref": "#/$defs/localized" },
    "interpretationId": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1, "description": "实际使用的种子。GET 省略时由服务端生成随机字符串并回显。" },
    "reversedProbability": {
      "enum": [0, 25, 50],
      "description": "逆位概率，仅允许这三种取值。"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "description": "按位置 order 递增排列的牌。",
      "items": { "$ref": "#/$defs/drawnCard" }
    }
  },
  "$defs": {
    "localized": {
      "title": "Localized",
      "type": "object",
      "required": ["zh", "ja"],
      "additionalProperties": false,
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "ja": { "type": "string", "minLength": 1 }
      }
    },
    "drawnCard": {
      "title": "DrawnCard",
      "type": "object",
      "required": ["slot", "card", "reversed", "prompt"],
      "additionalProperties": false,
      "properties": {
        "slot": { "$ref": "layout.schema.json#/$defs/slot", "description": "这张牌落到的位置。" },
        "card": { "$ref": "deck.schema.json#/$defs/card", "description": "抽到的牌面数据。" },
        "reversed": { "type": "boolean", "description": "true 为逆位（含义反转），false 为正位。" },
        "prompt": {
          "$ref": "#/$defs/localized",
          "description": "由解读策略 template 插值得到的成句提示：{slot} 位置名、{meaning} 位置含义、{word} 词、{orientation} 正/逆位标签、{interpretation} 该词在该方向的释义、{question} 该词在该方向的问句、{slotQuestion} 位置问句。"
        }
      }
    }
  }
}
